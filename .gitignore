# Di terminal, buat file .gitignore
echo "# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Django
*.log
*.pot
*.pyc
local_settings.py
db.sqlite3
media/
staticfiles/

# Virtual Environment
venv/
venv/*
env/
env/*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Migrations (opsional, bisa di-uncomment)
# */migrations/00*.py
# */migrations/__pycache__/

# Backup files
*.bak
*.backup
*.db
" > .gitignore